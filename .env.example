GEMINI_API_KEY=
# Model names change and big Flash models are often overloaded: pick one your key can actually call (2026-11-18: flash-lite responded fastest)
GEMINI_MODEL=gemini-3.1-flash-lite
# tried in order if the model above is overloaded or out of quota (check client.models.list() for your key)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash
HUNTER_API_KEY=
MY_EMAIL=
SEND_MODE=TEST
# Resend (https://resend.com): API key + sender. onboarding@resend.dev only delivers to your own Resend account email.
RESEND_API_KEY=
MAIL_FROM=Outreach <onboarding@resend.dev>
