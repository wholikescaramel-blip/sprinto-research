# Only the static demo/ is served. Keep everything else (code, secrets, data) off Vercel's uploads.
# Patterns are anchored with a leading slash so they only match the repo root (demo/data must be kept).
/.env
/.env.*
/credentials.json
/token.json
/data
/.venv
/.pytest_cache
/src
/tests
/scripts
/web
/config
/docs
/pyproject.toml
/README.md
/.claude
