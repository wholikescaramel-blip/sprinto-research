{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{src/**,config/**,seed/**}",
      "excludeFiles": "{tests/**,demo/**,docs/**,web/**,public/**,scripts/**,data/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
